# Server Configuration
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Development: Disable page limits (set to 'true' to disable all page limit checks)
# DISABLE_LIMITS=true

# JWT Secret for authentication
# IMPORTANT: Change this to a secure random string in production
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-12345678

# Google OAuth Configuration
# Get credentials from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# Stripe Configuration
# Get keys from: https://dashboard.stripe.com/apikeys
STRIPE_PUBLISHABLE_KEY=pk_live_your_publishable_key_here
STRIPE_SECRET_KEY=sk_live_your_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Stripe Price IDs (create recurring prices in Stripe Dashboard)
# These should be monthly recurring subscription prices
STRIPE_STARTER_PRICE_ID=price_your_starter_price_id
STRIPE_PROFESSIONAL_PRICE_ID=price_your_professional_price_id
STRIPE_ENTERPRISE_PRICE_ID=price_your_enterprise_price_id

# Database Configuration (PostgreSQL)
# Use either DATABASE_URL (recommended) OR individual DB_* variables

# Option 1: Single connection string (recommended)
DATABASE_URL=postgresql://converter_app:your-password-here@localhost:5432/bank_statement_converter

# Option 2: Individual components (alternative)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=bank_statement_converter
# DB_USER=converter_app
# DB_PASSWORD=your-password-here

# Production Database Examples:
# Railway: postgresql://postgres:xxxxx@containers-us-west-xxx.railway.app:5432/railway
# Render: postgresql://user:xxxxx@dpg-xxxxx.oregon-postgres.render.com/dbname
# Supabase: postgresql://postgres:xxxxx@db.xxxxx.supabase.co:5432/postgres
# Heroku: postgresql://user:xxxxx@ec2-xxx.compute-1.amazonaws.com:5432/dbname

# Database Pool Configuration (optional)
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=2000

# Email Configuration (Brevo/Sendinblue SMTP)
# Get credentials from: https://app.brevo.com/settings/keys/smtp
BREVO_SMTP_USER=your-brevo-login-email@example.com
BREVO_SMTP_KEY=your-brevo-smtp-api-key-here

# Admin Configuration
# Set this to the email address that should have admin access to the blog
ADMIN_EMAIL=macon4001@gmail.com

# Google Vision OCR Configuration (Optional - Premium fallback for scanned PDFs)
# Google Vision provides high-accuracy OCR when Tesseract fails or has low confidence
# Cost: ~$1.50 per 1000 pages (first 1000 pages/month free)
# Get credentials from: https://console.cloud.google.com/apis/credentials

# Option 1: Service Account (Recommended for production)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Option 2: API Key (Simpler for development)
# GOOGLE_VISION_API_KEY=your_api_key_here

# Note: If neither is configured, OCR will use Tesseract only (free, but lower accuracy)
